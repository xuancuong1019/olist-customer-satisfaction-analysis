Project olist_erd {
  database_type: 'SQL Server'
  Note: 'Logical ERD for Olist e-commerce dataset'
}

Table olist_customers {
  customer_id varchar(32) [pk, not null]
  customer_unique_id varchar(32) [not null]
  customer_zip_code_prefix varchar(5) [not null]
  customer_city varchar(32) [not null]
  customer_state varchar(2) [not null]
}

Table olist_geolocation {
  geolocation_zip_code_prefix varchar(5) [pk, not null]
  geolocation_lat decimal(20,18) [not null]
  geolocation_lng decimal(20,18) [not null]
  geolocation_city varchar(38) [not null]
  geolocation_state varchar(2) [not null]
}

Table olist_orders {
  order_id varchar(32) [pk, not null]
  customer_id varchar(32)  [not null]
  order_status varchar(11)  [not null]
  order_purchase_timestamp datetime2 [not null]
  order_approved_at datetime2 
  order_delivered_carrier_date datetime2
  order_delivered_customer_date datetime2
  order_estimated_delivery_date datetime2  [not null]
}

Table olist_order_items {
  order_id varchar(32) [not null]
  order_item_id int [not null]
  product_id varchar(32) [not null]
  seller_id varchar(32) [not null]
  shipping_limit_date datetime2 [not null]
  price decimal(5,2) [not null]
  freight_value decimal(5,2) [not null]

  indexes {
    (order_id, order_item_id) [pk]
  }
}

Table olist_order_payments {
  order_id varchar(32) [not null]
  payment_sequential int [not null]
  payment_type varchar(11) [not null]
  payment_installments int [not null]
  payment_value decimal(7,2) [not null]

  indexes {
    (order_id, payment_sequential) [pk]
  }
}

Table olist_order_reviews {
  review_id varchar(32) [not null]
  order_id varchar(32) [not null]
  review_score int [not null]
  review_comment_title varchar(26) [not null]
  review_comment_message varchar(208) [not null]
  review_creation_date datetime2 [not null]
  review_answer_timestamp datetime2 [not null]

  indexes {
    (review_id, order_id) [pk]
  }
}

Table olist_products {
  product_id varchar(32) [pk, not null]
  product_category_name varchar(46) [not null]
  product_name_lenght int
  product_description_lenght int
  product_photos_qty int
  product_weight_g int
  product_length_cm int
  product_height_cm int
  product_width_cm int
}

Table olist_sellers {
  seller_id varchar(32) [pk, not null]
  seller_zip_code_prefix varchar(5) [not null]
  seller_city varchar(40) [not null]
  seller_state varchar(2) [not null]
}

Table product_category_name_translation {
  product_category_name varchar(46) [pk, not null]
  product_category_name_english varchar(39) [not null]
}


// Foreign-key relationships

Ref: olist_customers.customer_zip_code_prefix > olist_geolocation.geolocation_zip_code_prefix

Ref: olist_order_items.order_id > olist_orders.order_id
Ref: olist_order_items.seller_id > olist_sellers.seller_id
Ref: olist_order_items.product_id > olist_products.product_id

Ref: olist_order_payments.order_id > olist_orders.order_id

Ref: olist_order_reviews.order_id > olist_orders.order_id

Ref: olist_orders.customer_id > olist_customers.customer_id

Ref: olist_products.product_category_name > product_category_name_translation.product_category_name

Ref: olist_sellers.seller_zip_code_prefix > olist_geolocation.geolocation_zip_code_prefix
